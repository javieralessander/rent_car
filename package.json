{
  "name": "rentcar-json-server",
  "version": "1.0.0",
  "description": "JSON Server for RentCar Flutter App Development",
  "main": "index.js",
  "scripts": {
    "start": "json-server --watch db.json --port 3000 --host 0.0.0.0",
    "dev": "json-server --watch db.json --port 3000 --host 0.0.0.0 --delay 500",
    "install-server": "npm install -g json-server"
  },
  "keywords": [
    "json-server",
    "rentcar",
    "flutter",
    "api",
    "mock"
  ],
  "author": "RentCar Development Team",
  "license": "MIT",
  "devDependencies": {
    "json-server": "^0.17.4"
  }
}